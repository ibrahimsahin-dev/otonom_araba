<Window x:Class="OtonomArabaArayuz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OtonomArabaArayuz"
        mc:Ignorable="d"
        Title="Otonom Araba Telemetri" Height="800" Width="900"
        Background="#1E1E1E" Foreground="White">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Gauges -->
            <RowDefinition Height="*"/>    <!-- Map -->
            <RowDefinition Height="100"/>  <!-- Logs (Reduced) -->
        </Grid.RowDefinitions>

        <!-- Header / Connection Settings -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="10" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                <TextBox x:Name="txtPort" Text="5000" Width="80" Height="30" VerticalContentAlignment="Center" Padding="5"/>
                <Button x:Name="btnConnect" Content="Server Başlat" Click="btnConnect_Click" 
                        Margin="20,0,0,0" Width="120" Height="30" Background="#007ACC" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Gauges -->
        <Grid Grid.Row="1" Margin="0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Speed Gauge Area -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="15" Margin="0,0,5,0" Padding="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="HIZ (cm/s)" FontSize="18" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblSpeed" Text="0.0" FontSize="48" FontWeight="Bold" Foreground="#00CC6A" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="pbSpeed" Minimum="0" Maximum="200" Height="10" Width="200" Margin="0,10,0,0" Foreground="#00CC6A"/>
                </StackPanel>
            </Border>

            <!-- Distance Area -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="15" Margin="5,0,0,0" Padding="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="MESAFE (cm)" FontSize="18" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="lblDistance" Text="0.0" FontSize="48" FontWeight="Bold" Foreground="#007ACC" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAP / GRID Simulation -->
        <Border Grid.Row="2" Background="#111111" CornerRadius="10" Margin="0,10" ClipToBounds="True">
            <Grid>
                <!-- Grid Lines Canvas -->
                <Canvas x:Name="mapCanvas" Background="Transparent" SizeChanged="mapCanvas_SizeChanged"/>
                
                <!-- Info Overlay -->
                <TextBlock Text="Canlı Harita Simülasyonu" Foreground="#666" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10" Orientation="Horizontal">
                     <TextBlock Text="X: " Foreground="#888"/>
                     <TextBlock x:Name="lblPosX" Text="0" Foreground="White" Margin="0,0,10,0"/>
                     <TextBlock Text="Y: " Foreground="#888"/>
                     <TextBlock x:Name="lblPosY" Text="0" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Logs -->
        <Border Grid.Row="3" Background="#252526" CornerRadius="10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Sistem Logları" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox x:Name="lstLog" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#DDDDDD" FontFamily="Consolas"/>
            </Grid>
        </Border>
    </Grid>
</Window>
